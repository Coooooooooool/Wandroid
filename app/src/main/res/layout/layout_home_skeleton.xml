<?xml version="1.0" encoding="utf-8"?>
<com.eric.wandroid.common.ui.SkeletonLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeSkeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="104dp"
                android:layout_height="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_skeleton_block" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="136dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_skeleton_block" />

                <View
                    android:layout_width="136dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_skeleton_block" />
            </LinearLayout>

            <include layout="@layout/item_skeleton_article" />
            <include layout="@layout/item_skeleton_article" />
            <include layout="@layout/item_skeleton_article" />
        </LinearLayout>
    </ScrollView>
</com.eric.wandroid.common.ui.SkeletonLayout>
