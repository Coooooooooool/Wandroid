        <activity
            android:name=".ui.history.ReadingHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.extra.ExtraContentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.wenda.WendaDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.moyu.MoyuVideoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.moyu.news.NewsListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.moyu.news.NewsDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.moyu.internet.InternetNewsActivity"
            android:exported="false" />
